rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:]+$');
    }

    // Admin authorization check (document in /admins or bootstrapped developer email)
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'mdmaim.69@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isApprovedUser() {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        )
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isSignedIn() || isAdmin();
      allow list: if isSignedIn();

      // Normal users create initial pending profile with role 'user' and status 'pending'
      allow create: if isSignedIn() && request.auth.uid == userId &&
        incoming().keys().hasAll(['uid', 'email', 'username', 'status', 'role']) &&
        incoming().uid == request.auth.uid &&
        incoming().email is string && incoming().email.size() <= 256 &&
        incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 50 &&
        incoming().role == 'user' &&
        incoming().status == 'pending';

      // Self-update allowed fields only (never allow user to change status or role)
      allow update: if (
        isAdmin() || (
          isSignedIn() && request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'avatarUrl', 'bio', 'updatedAt', 'lastActive', 'postCount', 'friendCount', 'likeCount', 'blockedUsers'])
        )
      );

      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // ADMINS REGISTRY
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // POSTS
    match /posts/{postId} {
      // Public posts viewable by anyone, private/friends restricted
      allow get: if (resource.data.visibility == 'public' && resource.data.status == 'active') ||
                    (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
                    isAdmin();
      allow list: if (resource.data.visibility == 'public' && resource.data.status == 'active') ||
                     (isSignedIn() && resource.data.ownerId == request.auth.uid) ||
                     isAdmin();

      // Only approved users can publish
      allow create: if isApprovedUser() &&
        incoming().ownerId == request.auth.uid &&
        incoming().title is string && incoming().title.size() <= 200 &&
        incoming().imageUrl is string && incoming().imageUrl.size() <= 2048 &&
        incoming().status == 'active';

      // Owners can update details or soft-delete; admins can moderate
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'tags', 'category', 'visibility', 'sharingAllowed', 'downloadAllowed', 'status', 'updatedAt', 'likeCount', 'commentCount', 'viewCount'])
      );

      allow delete: if isAdmin() || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // COMMENTS
    match /comments/{commentId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() &&
        incoming().authorId == request.auth.uid &&
        incoming().content is string && incoming().content.size() <= 1000;
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.authorId == request.auth.uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['content', 'status', 'updatedAt', 'likeCount'])
      );
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // LIKES
    match /likes/{likeId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // FRIEND REQUESTS
    match /friendRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // FRIENDS
    match /friends/{friendshipId} {
      allow read: if isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().user1Id == request.auth.uid || incoming().user2Id == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.user1Id == request.auth.uid ||
        resource.data.user2Id == request.auth.uid ||
        isAdmin()
      );
    }

    // CHATS & MESSAGES
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );
      allow create: if isSignedIn() && (
        request.auth.uid in incoming().participantIds
      );
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participantIds || isAdmin()
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds || isAdmin()
        );
        allow create: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds &&
          incoming().senderId == request.auth.uid
        );
        allow update: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds ||
          isAdmin()
        );
        allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
      }
    }

    // NOTIFICATIONS
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // FAVORITES
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // REPORTS
    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {
      allow read: if true; // Publicly readable for active announcements
      allow write: if isAdmin();
    }

    // ADMIN LOGS
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Append-only audit trail
    }

    // GLOBAL SETTINGS
    match /settings/{settingId} {
      allow read: if true; // Publicly readable platform settings (e.g. maintenanceMode, limits)
      allow write: if isAdmin();
    }
  }
}
